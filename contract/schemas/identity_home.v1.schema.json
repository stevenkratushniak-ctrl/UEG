  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "identity_id": {
      "pattern": "^ueg:identity:sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "protocol_version": {
      "const": "ueg-bplus/1",
      "type": "string"
    },
    "schema": {
      "const": "ueg.identity-home.v1",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "protocol_version",
    "identity_id"
  ],
  "title": "UEG B+ Evidence Home Marker v1",
  "type": "object"
}
